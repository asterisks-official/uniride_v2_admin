# ─── Backend ──────────────────────────────────────────────────────────────────
# Server-only, by design. There is deliberately no NEXT_PUBLIC equivalent: the
# browser calls /api on this app, and only the server knows where that forwards.
API_URL=http://localhost:3000/api/v1

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3001
# openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-with-at-least-32-characters-of-random
